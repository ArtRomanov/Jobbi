# Backend
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
DATABASE_URL=sqlite+aiosqlite:///./data/jobbi.db
ACCESS_TOKEN_EXPIRE_DAYS=7
SENTRY_DSN=
CORS_ORIGINS=http://localhost:5174
LOG_LEVEL=INFO

# LLM (Groq)
GROQ_API_KEY=
# Chat model (CV tailoring). gpt-oss since 2026-11-25 (was qwen/qwen3.8-27b).
GROQ_MODEL=openai/gpt-oss-20b
# Cap on one chat reply in tokens. gpt-oss counts its hidden reasoning here too,
# so a low cap can cut the reply or leave it empty.
CHAT_MAX_TOKENS=6000
# How hard a gpt-oss chat model reasons: low, medium or high (ignored for
# other models).
CHAT_REASONING_EFFORT=medium
# GROQ_MODEL's tokens-per-minute limit, which Groq checks against input +
# max_tokens of each request (gpt-oss-20b free tier: 8000). Older chat messages
# are left out and the reply cap lowered so each request fits.
CHAT_REQUEST_TOKEN_LIMIT=8000
# Reply tokens a chat request always keeps (gpt-oss reasons inside them).
CHAT_MIN_REPLY_TOKENS=2048
# Upper bound on estimated input tokens per chat request (CV, vacancy, history,
# tools), on top of what CHAT_REQUEST_TOKEN_LIMIT leaves.
CHAT_INPUT_TOKEN_BUDGET=6500
# Model the discovery worker uses to rate vacancies (separate from the chat model).
GROQ_DISCOVERY_MODEL=openai/gpt-oss-20b
# Rates posts while the discovery model is out of its daily Groq token quota
# (counted per model). Not the chat model. Empty disables the fallback.
GROQ_DISCOVERY_FALLBACK_MODEL=openai/gpt-oss-120b
# How many posts the discovery worker sends to the AI per user per day (user's
# local day). Sized for one user on the free Groq budget; raise only with a
# bigger plan.
DISCOVERY_DAILY_EVAL_LIMIT=150

# Frontend
VITE_API_URL=http://localhost:8003

# Telegram
TELEGRAM_BOT_TOKEN=
JOBBI_PUBLIC_URL=http://localhost:5174